{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2017", "DOM"],
    "strict": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "client/assets/scripts/core/**/*.ts",
    "client/assets/scripts/platform/**/*.ts",
    "client/assets/scripts/app/**/*.ts",
    "client/assets/scripts/view/reveal/RevealGeometry.ts",
    "client/assets/scripts/view/main/BattleSim.ts",
    "tests/**/*.ts"
  ]
}
